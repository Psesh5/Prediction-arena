# OpenRouter key used to query every competing model
OPENROUTER_API_KEY=

# Optional overrides
PORT=8787
ARENA_DB_PATH=data/arena.db
SYNC_INTERVAL_MINUTES=30
# Set to 1 to disable the background sync/forecast/resolve loop
ARENA_DISABLE_CRON=0
# Set to 1 to run one cycle immediately on boot (default off so restarts don't
# spend OpenRouter credits by surprise)
ARENA_RUN_ON_START=0
# Required to enable POST /api/cycle; unset disables the endpoint entirely
ARENA_ADMIN_KEY=
# Hard daily OpenRouter budget in USD; 0 disables paid forecasting entirely
ARENA_DAILY_SPEND_LIMIT_USD=5
# Max simultaneous forecast requests per cycle
ARENA_FORECAST_CONCURRENCY=4
